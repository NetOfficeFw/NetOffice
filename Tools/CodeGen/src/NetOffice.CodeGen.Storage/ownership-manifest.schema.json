{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netoffice.io/codegen/ownership-manifest.schema.json",
  "title": "NetOffice CodeGen ownership manifest",
  "type": "object",
  "required": ["schemaVersion", "manifestKind", "generatorVersion", "runHash", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestKind": { "const": "netoffice-codegen-ownership" },
    "generatorVersion": { "type": "string", "minLength": 1 },
    "runHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "length"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "length": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
